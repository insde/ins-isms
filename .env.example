# ================================================
# ins-isms – example config for dev and production
# ================================================
# copy this file file to .env and adjust the values according to the doc
# security sensitive varibles use also the `<KEY>_FILE`-pattern
# eample: `SESSION_SECRET_FILE=/run/secrets/session_secret`

# secure default is `production` if APP_ENV is not set. Only setting of `development`
# deactivates Secure-Cookie- and TLS-Proxy-checks for local development
APP_ENV=development
BIND_ADDR=127.0.0.1:8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Europe/Berlin
RUST_LOG=info

DATABASE_URL=postgres://ins_isms:ins_isms_dev@127.0.0.1:5432/ins_isms
# optional: additional db-role for Migrations in Production
# MIGRATION_DATABASE_URL=postgres://ins_migrator:CHANGE_ME@127.0.0.1:5432/ins_isms

# minimum 32 Bytes random value for example with `openssl rand -hex 32`
SESSION_SECRET=dev-only-change-me-in-production-0123456789abcdef0123456789abcdef
SESSION_TTL_HOURS=12
# is in produktion always fixed to value `true` and can not be changed here
COOKIE_SECURE=false
TRUST_PROXY=false

# Admin-Seeding (works only if there is no admin in database yet) ------------
# INIT_ADMIN_EMAIL=admin@blasfase.de
# INIT_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS

# Content-Packs (catalogs and starter documents)
# production default is `false` (no seeding with catalogs/documents
# for evaluation for example content pack: SEED_STARTER_CONTENT=true and SEED_DIR=./seeds/example_pack
SEED_STARTER_CONTENT=false
SEED_DIR=./seeds

# file storage (BlobStorage)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/blobs
MAX_UPLOAD_BYTES=26214400

# DO NOT USE FOR NOW !!!!!
# Optional S3 buckets for file storage (STORAGE_BACKEND=s3)
# S3_ENDPOINT=https://s3.blafasel.de
# S3_BUCKET=ins-isms-blobs
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME

# PDF generation (Typst CLI & Corporate Design) -----------------------------
TYPST_BIN_PATH=typst
# optional: directory for own fonts
# TYPST_FONT_PATHS=/usr/share/fonts/truetype/liberation
# optional: for own Corporate Design styles in `theme.typ`
# PDF_TEMPLATE_DIR=/etc/ins-isms/pdf-templates

# DO NOT USE FOR NOW !!!!!
# Optional: OpenID Connect (OIDC SSO with PKCE)
# OIDC_ISSUER_URL=https://sso.ihre-organisation.de/realms/main
# OIDC_CLIENT_ID=ins-isms
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_ROLE_CLAIM=groups
# OIDC_AUTO_PROVISION=false

# DO NOT USE FOR NOW !!!!!
# Optional: SMTP-Alerting (Fristen & NIS2-Eskalationen)
# when SMTP_HOST is empty, the system does not sent any emails
# SMTP_HOST=mail.blafasel.de
# SMTP_PORT=587
# SMTP_USERNAME=isms-notify@blafasel.de
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=isms@blafasel.de
